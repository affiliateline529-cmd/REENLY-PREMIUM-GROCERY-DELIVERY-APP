{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Store user profile information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phoneNumber": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "fullName", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Grocery product details.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "categoryId": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "isPopular": { "type": "boolean" },
        "isDailyEssential": { "type": "boolean" },
        "stock": { "type": "number" }
      },
      "required": ["name", "categoryId", "price", "unit", "image", "stock"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categories.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 50 },
        "icon": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "out_for_delivery", "delivered", "cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "total", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles collection"
    },
    "products": {
      "schema": "Product",
      "description": "Available products"
    },
    "categories": {
      "schema": "Category",
      "description": "Product categories"
    },
    "orders": {
      "schema": "Order",
      "description": "Customer orders"
    }
  }
}
